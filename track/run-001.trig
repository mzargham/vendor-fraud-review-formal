@prefix vfr: <https://example.org/vfr#> .
@prefix run: <https://example.org/vfr/track/run-001#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Track of one synthetic execution of the Vendor Fraud Review Op — the
# escalated run modeled in model/vendor-fraud-review.sysml (confidence 0.71
# fires GATE-01; vendor_risk "high" fires GATE-04; a named human approves).
# Graph layout: interface / evidence / decisions / approvals / provenance.
# All names and values are synthetic demonstration data.

run:provenance {
    run:execution
        a prov:Activity, vfr:OpExecution ;
        rdfs:label "Vendor Fraud Review Op — run 001 (escalated)" ;
        vfr:op "vendor-fraud-review" ;
        vfr:framesApplied "company-policy", "procurement-rules", "fraud-detection-methodology" ;
        vfr:cogsInvoked "invoice-extraction-cog", "vendor-risk-cog", "anomaly-summary-cog" ;
        prov:used run:evidence-invoice-batch, run:evidence-vendor-risk-score ;
        vfr:finalOutput run:output-anomaly-summary ;
        vfr:parameters run:policy-parameters ;
        vfr:aggregateOutcome "executed" ;
        prov:startedAtTime "2026-09-04T14:00:00Z"^^xsd:dateTime ;
        prov:endedAtTime "2026-09-04T14:07:42Z"^^xsd:dateTime .

    run:output-anomaly-summary
        a prov:Entity ;
        rdfs:label "Anomaly summary; vendor V-2214 flagged for review" ;
        prov:wasGeneratedBy run:execution .

    # The configuration parameters in force for this run (WP section 5.3:
    # Track contents include "the model versions and configuration
    # parameters"). Values are the model's factored defaults.
    run:policy-parameters
        a vfr:ConfigurationParameters ;
        rdfs:label "Validation Strategy parameters in force (model defaults)" ;
        vfr:confidenceThreshold 0.80 ;
        vfr:consensusDisagreementThreshold 0.25 ;
        vfr:vendorRiskTrigger "high" .
}

run:interface {
    # The interface contract (adjudicated: GAP-05): every value the policy
    # reads is provided by an identified oracle, and the Track cites the
    # call — what service, what payload sent, what response code, what
    # response. The system applies its policies to these values; it is not
    # their provider. Numerical precision lives inside the oracles or in
    # documented threshold rules (INTERFACE-01 in the model).

    <urn:example:service:extraction-confidence>
        a vfr:Oracle, prov:SoftwareAgent ;
        rdfs:label "extraction-confidence service (invoice-extraction-cog telemetry, v2.3.1)" .

    <urn:example:service:consensus-comparator>
        a vfr:Oracle, prov:SoftwareAgent ;
        rdfs:label "consensus-comparator service (v1.4.0)" .

    <urn:example:service:sensitive-data-scanner>
        a vfr:Oracle, prov:SoftwareAgent ;
        rdfs:label "sensitive-data-scanner service (v5.0.2)" .

    <urn:example:service:vendor-risk-cog>
        a vfr:Oracle, prov:SoftwareAgent ;
        rdfs:label "vendor-risk-cog scoring endpoint (v0.9.7)" .

    run:oracle-call-confidence
        a vfr:OracleCall, prov:Activity ;
        vfr:service <urn:example:service:extraction-confidence> ;
        vfr:requestPayload "{\"op\":\"vendor-fraud-review\",\"run\":\"run-001\",\"variable\":\"confidence\",\"batch\":\"invoice-batch-2026-08\"}" ;
        vfr:responseCode "200" ;
        vfr:responsePayload "{\"confidence\":0.71}" ;
        prov:generated run:reading-confidence ;
        prov:endedAtTime "2026-09-04T14:03:11Z"^^xsd:dateTime .

    run:reading-confidence
        a vfr:Reading ;
        vfr:variable "confidence" ;
        vfr:value 0.71 ;
        prov:wasGeneratedBy run:oracle-call-confidence .

    run:oracle-call-consensus
        a vfr:OracleCall, prov:Activity ;
        vfr:service <urn:example:service:consensus-comparator> ;
        # Which disagreement metric produced this number is an open policy
        # choice (GAP-04): the Track records which one THIS run used;
        # recording is not endorsing.
        vfr:metric "strict-quorum-undecodable" ;
        vfr:requestPayload "{\"op\":\"vendor-fraud-review\",\"run\":\"run-001\",\"variable\":\"consensus_disagreement\",\"cogs\":[\"invoice-extraction-cog\",\"vendor-risk-cog\",\"anomaly-summary-cog\"]}" ;
        vfr:responseCode "200" ;
        vfr:responsePayload "{\"consensus_disagreement\":0.10}" ;
        prov:generated run:reading-consensus ;
        prov:endedAtTime "2026-09-04T14:04:02Z"^^xsd:dateTime .

    run:reading-consensus
        a vfr:Reading ;
        vfr:variable "consensus_disagreement" ;
        vfr:value 0.10 ;
        prov:wasGeneratedBy run:oracle-call-consensus .

    run:oracle-call-sensitive
        a vfr:OracleCall, prov:Activity ;
        vfr:service <urn:example:service:sensitive-data-scanner> ;
        vfr:requestPayload "{\"op\":\"vendor-fraud-review\",\"run\":\"run-001\",\"variable\":\"sensitive_data_detected\",\"batch\":\"invoice-batch-2026-08\"}" ;
        vfr:responseCode "200" ;
        vfr:responsePayload "{\"sensitive_data_detected\":false}" ;
        prov:generated run:reading-sensitive ;
        prov:endedAtTime "2026-09-04T14:04:40Z"^^xsd:dateTime .

    run:reading-sensitive
        a vfr:Reading ;
        vfr:variable "sensitive_data_detected" ;
        vfr:value false ;
        prov:wasGeneratedBy run:oracle-call-sensitive .

    run:oracle-call-vendor-risk
        a vfr:OracleCall, prov:Activity ;
        vfr:service <urn:example:service:vendor-risk-cog> ;
        vfr:requestPayload "{\"op\":\"vendor-fraud-review\",\"run\":\"run-001\",\"variable\":\"vendor_risk\",\"vendor\":\"V-2214\"}" ;
        vfr:responseCode "200" ;
        vfr:responsePayload "{\"vendor_risk\":\"high\"}" ;
        prov:generated run:reading-vendor-risk ;
        prov:endedAtTime "2026-09-04T14:05:19Z"^^xsd:dateTime .

    run:reading-vendor-risk
        a vfr:Reading ;
        vfr:variable "vendor_risk" ;
        vfr:value "high" ;
        prov:wasGeneratedBy run:oracle-call-vendor-risk ;
        prov:wasDerivedFrom run:evidence-vendor-risk-score .
}

run:evidence {
    run:evidence-invoice-batch
        a prov:Entity ;
        rdfs:label "Invoice batch 2026-08 (vendor V-2214), 37 invoices" ;
        vfr:payloadHash "sha256:9c3ad2f41b6f8f0f6f3f4f0a3e0d9b1c2a4e5d6f7a8b9c0d1e2f3a4b5c6d7e8f" ;
        prov:wasDerivedFrom <urn:example:erp:invoice-batch-2026-08> .

    run:evidence-vendor-risk-score
        a prov:Entity ;
        rdfs:label "Vendor risk score for V-2214: high" ;
        vfr:value "high" ;
        vfr:payloadHash "sha256:1f2e3d4c5b6a79881726354443526170fedcba9876543210ffeeddccbbaa9900" ;
        prov:wasAttributedTo <urn:example:cog:vendor-risk-cog> .
}

run:decisions {
    # Guard results — automatic checks, per WP section 5.6 guard lists.
    run:guard-schema
        a earl:Assertion ;
        rdfs:label "schema-guard (post_run)" ;
        earl:test <urn:example:guard:schema-guard> ;
        earl:subject run:execution ;
        earl:mode earl:automatic ;
        earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                      earl:info "extracted invoice records conform to the declared schema" ] .

    run:guard-confidence
        a earl:Assertion ;
        rdfs:label "confidence-guard (in_flight)" ;
        earl:test <urn:example:guard:confidence-guard> ;
        earl:subject run:execution ;
        earl:mode earl:automatic ;
        earl:result [ a earl:TestResult ; earl:outcome earl:failed ;
                      earl:info "extraction confidence 0.71 is below the 0.80 gate threshold" ] .

    run:guard-source-grounding
        a earl:Assertion ;
        rdfs:label "source-grounding-guard (post_run)" ;
        earl:test <urn:example:guard:source-grounding-guard> ;
        earl:subject run:execution ;
        earl:mode earl:automatic ;
        earl:result [ a earl:TestResult ; earl:outcome earl:cantTell ;
                      earl:info "the cited invoice passage is ambiguous about the delivery date; the claim can be neither grounded nor refuted from the approved sources" ] .

    # Gate decisions — what the fired gates required, per the manifest.
    run:gate-decision-01
        a vfr:GateDecision ;
        rdfs:label "GATE-01 fired" ;
        vfr:gate "GATE-01" ;
        vfr:condition "confidence < 0.80" ;
        vfr:consequent "human_review_required" ;
        prov:wasInformedBy run:guard-confidence ;
        prov:used run:reading-confidence .

    run:gate-decision-02
        a vfr:GateDecision ;
        rdfs:label "GATE-04 fired" ;
        vfr:gate "GATE-04" ;
        vfr:condition "vendor_risk == high" ;
        vfr:consequent "human_approval_required" ;
        prov:wasInformedBy run:guard-vendor-risk-reading ;
        prov:used run:reading-vendor-risk .

    # Obligations raised by the fired gates (adjudicated: GAP-02 — a
    # then-clause names an obligation: a required action, abstract, not yet
    # materialized; a concrete action discharges it and must mutate state).
    run:obligation-human-review
        a vfr:Obligation ;
        rdfs:label "human review required" ;
        vfr:raisedBy run:gate-decision-01 .

    run:obligation-human-approval
        a vfr:Obligation ;
        rdfs:label "human approval required" ;
        vfr:raisedBy run:gate-decision-02 .

    run:guard-vendor-risk-reading
        a earl:Assertion ;
        rdfs:label "vendor risk reading (in_flight)" ;
        earl:test <urn:example:guard:tool-use-policy-guard> ;
        earl:subject run:execution ;
        earl:mode earl:automatic ;
        earl:result [ a earl:TestResult ; earl:outcome earl:failed ;
                      earl:info "vendor-risk-cog scored vendor V-2214 as high" ] .
}

run:approvals {
    # The concrete action: a human review, earl:manual with a named agent,
    # discharging both raised obligations AND mutating state (it generates
    # the post-review case state — an action that discharges an obligation
    # must also mutate state, per the GAP-02 ruling).
    run:approval-01
        a earl:Assertion, prov:Activity ;
        rdfs:label "human review and approval of the vendor flag" ;
        earl:test <urn:example:step:human-review> ;
        earl:subject run:execution ;
        earl:mode earl:manual ;
        earl:result [ a earl:TestResult ; earl:outcome earl:passed ;
                      earl:info "flag upheld after review" ] ;
        vfr:discharges run:obligation-human-review, run:obligation-human-approval ;
        vfr:rationale "Reviewed the three lowest-confidence extractions against the invoice PDFs; amounts and dates check out. The risk score is driven by the 40 percent month-over-month invoice volume increase; flagging for procurement follow-up is warranted." ;
        prov:used run:evidence-invoice-batch, run:evidence-vendor-risk-score ;
        prov:generated run:state-after-review ;
        prov:wasAssociatedWith run:approver-rivera ;
        prov:qualifiedAssociation [ a prov:Association ;
                                    prov:agent run:approver-rivera ;
                                    prov:hadRole vfr:role-accounts-payable-analyst ] .

    run:state-after-review
        a prov:Entity ;
        rdfs:label "Case state after human review: flag upheld, both obligations discharged" ;
        prov:wasGeneratedBy run:approval-01 .

    run:approver-rivera
        a prov:Agent, prov:Person ;
        rdfs:label "J. Rivera (accounts-payable analyst)" .
}
