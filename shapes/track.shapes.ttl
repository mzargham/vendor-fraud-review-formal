@prefix vfr: <https://example.org/vfr#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shapes derived from the whitepaper's own declarations:
# - the section 5.6 track.include list (frames_used, cogs_invoked,
#   source_documents, guard_results, gate_decisions, human_approvals,
#   final_output), and
# - the gate consequents that require a human.
# A Track that fails these is missing something the manifest says it retains.

vfr:GateDecisionObligationShape
    a sh:NodeShape ;
    sh:targetClass vfr:GateDecision ;
    sh:property [
        sh:path [ sh:inversePath vfr:raisedBy ] ;
        sh:minCount 1 ;
        sh:message "Gate fired but raised no obligation (its then-clause names a required action)." ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:message "A Gate decision must cite the reading it evaluated; the policy applies to oracle-provided values, it does not provide them." ;
    ] .

vfr:ReadingShape
    a sh:NodeShape ;
    sh:targetClass vfr:Reading ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "A reading must cite the oracle call that produced it." ;
    ] ;
    sh:property [
        sh:path vfr:variable ;
        sh:minCount 1 ;
        sh:message "A reading must name the variable it provides." ;
    ] ;
    sh:property [
        sh:path vfr:value ;
        sh:minCount 1 ;
        sh:message "A reading must carry the value the oracle returned." ;
    ] .

vfr:OracleCallShape
    a sh:NodeShape ;
    sh:targetClass vfr:OracleCall ;
    sh:property [
        sh:path vfr:service ;
        sh:minCount 1 ;
        sh:message "An oracle call must identify the service that was called." ;
    ] ;
    sh:property [
        sh:path vfr:requestPayload ;
        sh:minCount 1 ;
        sh:message "An oracle call must record the payload that was sent." ;
    ] ;
    sh:property [
        sh:path vfr:responseCode ;
        sh:minCount 1 ;
        sh:message "An oracle call must record the response code it received." ;
    ] ;
    sh:property [
        sh:path vfr:responsePayload ;
        sh:minCount 1 ;
        sh:message "An oracle call must record the response it received." ;
    ] .

vfr:ObligationShape
    a sh:NodeShape ;
    sh:targetClass vfr:Obligation ;
    sh:property [
        sh:path [ sh:inversePath vfr:discharges ] ;
        sh:minCount 1 ;
        sh:message "Obligation raised but not discharged: no discharging action recorded (section 5.6 lists human_approvals in the Track; only the escalation target's actor is unspecified — adjudicated: GAP-09)." ;
    ] .

vfr:DischargingActionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf vfr:discharges ;
    sh:property [
        sh:path earl:mode ;
        sh:minCount 1 ;
        sh:message "A discharging action must declare its mode: earl:manual for a human act, earl:automatic for another system outside the modeled Op acting on it (adjudicated: GAP-09 — review, approval, and expert review are paper-named human per sections 5.6, 5.1 and 5.5; only the escalation target's actor is unspecified; a per-obligation-type mode constraint is noted as future work)." ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:message "A discharging action, approval included, must name the party accountable for it (prov:wasAssociatedWith) — human or not, an accountable counterparty is assumed (adjudicated: GAP-09)." ;
    ] ;
    sh:property [
        sh:path vfr:rationale ;
        sh:minCount 1 ;
        sh:message "A discharging action must carry a rationale." ;
    ] ;
    sh:property [
        sh:path prov:generated ;
        sh:minCount 1 ;
        sh:message "An action that discharges an obligation must also mutate state (record what it generated)." ;
    ] .

vfr:AssertionShape
    a sh:NodeShape ;
    sh:targetClass earl:Assertion ;
    sh:property [
        sh:path earl:mode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( earl:automatic earl:manual ) ;
        sh:message "Every assertion must declare exactly one mode, and its domain is closed: earl:automatic or earl:manual." ;
    ] ;
    sh:property [
        sh:path ( earl:result earl:outcome ) ;
        sh:minCount 1 ;
        sh:message "Every assertion must carry an outcome (passed / failed / cantTell)." ;
    ] .

vfr:OpExecutionShape
    a sh:NodeShape ;
    sh:targetClass vfr:OpExecution ;
    sh:property [
        sh:path vfr:framesApplied ;
        sh:minCount 1 ;
        sh:message "Track must include frames_used (section 5.6 track.include)." ;
    ] ;
    sh:property [
        sh:path vfr:cogsInvoked ;
        sh:minCount 1 ;
        sh:message "Track must include cogs_invoked (section 5.6 track.include)." ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:message "Track must include source_documents (section 5.6 track.include)." ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath earl:subject ] ;
        sh:minCount 1 ;
        sh:message "Track must include guard_results (section 5.6 track.include)." ;
    ] ;
    sh:property [
        sh:path vfr:parameters ;
        sh:minCount 1 ;
        sh:message "Track must include the configuration parameters in force (section 5.3 Track contents)." ;
    ] ;
    sh:property [
        sh:path vfr:aggregateOutcome ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "executed" "noOp" ) ;
        sh:message "Track must state exactly one aggregate outcome, and its domain is closed: executed or noOp (GAP-06 adjudication; domain closed per external review, 2026-09-05)." ;
    ] ;
    # GAP-07 adjudication: final_output inclusion is CONDITIONAL on the
    # aggregate outcome. This is a judgment, and it departs from the pinned
    # draft (Rev 9 section 5.6 lists final_output unconditionally); the
    # departure is acknowledged here and logged in open-questions/.
    sh:sparql [
        sh:message "An executed run's Track must include final_output (section 5.6 track.include, conditional reading — GAP-07)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://example.org/vfr#aggregateOutcome> "executed" .
                FILTER NOT EXISTS { $this <https://example.org/vfr#finalOutput> ?o }
            }""" ;
    ] ;
    sh:sparql [
        sh:message "A noOp run's Track cites no final_output, because nothing crossed the boundary: the Track is the internal record of the system of interest, and final_output names an action output that crossed to an external system. Everything else about the stopped run — readings, guard results, the gate decision, the stop and its escalation, and any artifact withheld at the boundary — is retained and checked as for an executed run: the record that the Op tried, that policy prevented it, and why. This conditional reading departs from the pinned draft's unconditional include list (GAP-07 adjudication, refined 2026-09-05)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://example.org/vfr#aggregateOutcome> "noOp" .
                $this <https://example.org/vfr#finalOutput> ?o .
            }""" ;
    ] .

# Second external review (2026-09-05). Three shapes close two findings.
# GAP-12: an oracle call that names a disagreement metric must carry the
# metric's input, or the recorded value is a number nobody can recompute.
# And the one-directionality the review found in the model's gates had a
# twin in this record: nothing tied a gate decision to the value of the
# reading it cited, so a Track could show a reading past its threshold
# with no decision, or a decision on a reading that could not have fired
# the gate. Both directions are now refused, against the parameters in
# force for the run (the vfr:ConfigurationParameters node the execution
# records).

vfr:MetricInputShape
    a sh:NodeShape ;
    sh:targetClass vfr:OracleCall ;
    sh:sparql [
        sh:message "An oracle call that names a disagreement metric must record the metric's input — the fact-by-checker answer matrix — so the recorded value can be recomputed by anyone holding the Track (adjudicated: GAP-12)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://example.org/vfr#metric> ?metric .
                FILTER NOT EXISTS { $this <https://example.org/vfr#answerMatrix> ?matrix }
            }""" ;
    ] .

vfr:GateDecisionConsistencyShape
    a sh:NodeShape ;
    sh:targetClass vfr:GateDecision ;
    sh:sparql [
        sh:message "A gate decision cites a reading whose value does not satisfy the gate's condition against the parameters in force: the Track says the gate fired on a value that could not have fired it (second external review, 2026-09-05)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://example.org/vfr#gate> ?gate ;
                      <http://www.w3.org/ns/prov#used> ?reading .
                ?reading <https://example.org/vfr#value> ?v .
                ?p a <https://example.org/vfr#ConfigurationParameters> ;
                   <https://example.org/vfr#confidenceThreshold> ?ct ;
                   <https://example.org/vfr#consensusDisagreementThreshold> ?dt ;
                   <https://example.org/vfr#vendorRiskTrigger> ?rt .
                FILTER (
                    (?gate = "GATE-01" && !(?v < ?ct)) ||
                    (?gate = "GATE-02" && !(?v > ?dt)) ||
                    (?gate = "GATE-03" && ?v != true) ||
                    (?gate = "GATE-04" && str(?v) != ?rt)
                )
            }""" ;
    ] .

vfr:UngatedReadingShape
    a sh:NodeShape ;
    sh:targetClass vfr:Reading ;
    sh:sparql [
        sh:message "A reading whose value satisfies a gate's condition against the parameters in force has no recorded gate decision: the Track shows the condition held and hides whether the gate fired (second external review, 2026-09-05)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://example.org/vfr#variable> ?var ;
                      <https://example.org/vfr#value> ?v .
                ?p a <https://example.org/vfr#ConfigurationParameters> ;
                   <https://example.org/vfr#confidenceThreshold> ?ct ;
                   <https://example.org/vfr#consensusDisagreementThreshold> ?dt ;
                   <https://example.org/vfr#vendorRiskTrigger> ?rt .
                FILTER (
                    (?var = "confidence" && ?v < ?ct) ||
                    (?var = "consensus_disagreement" && ?v > ?dt) ||
                    (?var = "sensitive_data_detected" && ?v = true) ||
                    (?var = "vendor_risk" && str(?v) = ?rt)
                )
                FILTER NOT EXISTS {
                    ?decision a <https://example.org/vfr#GateDecision> ;
                              <http://www.w3.org/ns/prov#used> $this .
                }
            }""" ;
    ] .

# GAP-07, refined (2026-09-05): noOp is a statement about the boundary, not
# about the record. An output the summary cog produced and the Op did not
# emit is retained as a withheld artifact — evidence the stop refers to, so
# an auditor can see what would have gone out — and is never cited as
# final_output, which names only what crossed the boundary.

vfr:WithheldOutputShape
    a sh:NodeShape ;
    sh:targetClass vfr:WithheldOutput ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "A withheld artifact must say which execution produced it (adjudicated: GAP-07, refined 2026-09-05)." ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:used ] ;
        sh:minCount 1 ;
        sh:message "A withheld artifact must be referred to by the action that withheld it: retained as evidence means the stop can point at what would have gone out (adjudicated: GAP-07, refined 2026-09-05)." ;
    ] ;
    sh:sparql [
        sh:message "A withheld artifact is retained as evidence and never cited as final_output: final_output names only what crossed the boundary (adjudicated: GAP-07, refined 2026-09-05)." ;
        sh:select """
            SELECT $this WHERE {
                ?execution <https://example.org/vfr#finalOutput> $this .
            }""" ;
    ] .
