@prefix trace: <https://example.org/vfr/trace#> .
@prefix adj:   <https://example.org/vfr/adjudications#> .
@prefix vfr:   <https://example.org/vfr#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# The model traceability map. Every named element of
# model/vendor-fraud-review.sysml traces to its provenance: grounded in
# the pinned whitepaper (vfr:groundedIn locator, quotes verified verbatim
# inside the cited section by the test suite), derived from a recorded
# ruling or design note of the named adjudicator (the judgment record in
# open-questions/adjudications.ttl), or declared scaffolding with a
# rationale (toolchain idioms needed to exercise the specification).
# Completeness in both directions is machine-checked
# (tests/test_model_trace.py); the shapes in shapes/trace.shapes.ttl
# refuse an element that traces to nothing.

trace:completedContext
    a vfr:ModelElement ;
    vfr:elementName "completedContext" ;
    vfr:kind "context" ;
    vfr:scaffoldRationale "trace context: drives the lifecycle to completed under -trace -instantiate" .

trace:stoppedContext
    a vfr:ModelElement ;
    vfr:elementName "stoppedContext" ;
    vfr:kind "context" ;
    vfr:scaffoldRationale "trace context: drives the lifecycle to stopped under -trace -instantiate" .

trace:AggregateOutcome
    a vfr:ModelElement ;
    vfr:elementName "AggregateOutcome" ;
    vfr:kind "enum def" ;
    vfr:groundedIn "§5.2" ;
    vfr:quote """the Op stops before external transmission""" ;
    vfr:derivedFromRuling adj:ruling-gap06 .

