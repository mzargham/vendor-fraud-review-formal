elmt:VendorFraudReview__Manifest__DissentFractionMetric___400
    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::Manifest::DissentFractionMetric::@0" ;
    sysml:elementId "VendorFraudReview__Manifest__DissentFractionMetric___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__Manifest__DissentFractionMetric ;
    sysml:owner elmt:VendorFraudReview__Manifest__DissentFractionMetric ;
    sysml:owningRelationship elmt:VendorFraudReview__Manifest__DissentFractionMetric___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__Manifest__DissentFractionMetric___400_om ;
    sysml:body """ Fraction of reader answers differing from each fact's
               modal expressed value, counting cantTell as dissent.
               Incentive implication: honest abstention is punished, so
               readers are pushed to guess rather than say cantTell. Note:
               on the paper's own section 5.5 example (three Cogs, two must
               agree) this metric FIRES the gate at the 0.25 threshold,
               contradicting the example's intent. """ .

