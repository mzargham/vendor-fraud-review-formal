elmt:VendorFraudReview__Manifest__DisagreementMetric___400
    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::Manifest::DisagreementMetric::@0" ;
    sysml:elementId "VendorFraudReview__Manifest__DisagreementMetric___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__Manifest__DisagreementMetric ;
    sysml:owner elmt:VendorFraudReview__Manifest__DisagreementMetric ;
    sysml:owningRelationship elmt:VendorFraudReview__Manifest__DisagreementMetric___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__Manifest__DisagreementMetric___400_om ;
    sysml:body """ adjudicated: GAP-04 — the rule does not say what the
               number is, and no metric is chosen HERE. This abstract def
               is the type signature: a metric maps a fact-by-reader
               answer matrix (answers in {agree, no, cantTell}) to a
               scalar in [0, 1] comparable against the manifest's 0.25
               threshold. Three type-satisfying alternatives with different
               semantics follow; which is fit for purpose is an open
               algorithmic policy design question, unlikely to have a
               unique correct answer, with different implications on
               incentives. The right answer is not limited to these three. """ .

