elmt:VendorFraudReview__RunConfigurations___400
    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::RunConfigurations::@0" ;
    sysml:elementId "VendorFraudReview__RunConfigurations___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__RunConfigurations ;
    sysml:owner elmt:VendorFraudReview__RunConfigurations ;
    sysml:owningRelationship elmt:VendorFraudReview__RunConfigurations___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__RunConfigurations___400_om ;
    sysml:body """ Concrete runs of the Op. Satisfy sweeps these: the clean run
           holds with no obligation raised; the escalated run holds because
           its obligations are raised AND discharged. The negative
           counterparts live in counterexamples/run-unattended.sysml and
           must fail. """ .

