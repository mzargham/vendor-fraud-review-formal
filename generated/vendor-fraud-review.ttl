    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::Manifest::CounterpartyAction::@0" ;
    sysml:elementId "VendorFraudReview__Manifest__CounterpartyAction___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__Manifest__CounterpartyAction ;
    sysml:owner elmt:VendorFraudReview__Manifest__CounterpartyAction ;
    sysml:owningRelationship elmt:VendorFraudReview__Manifest__CounterpartyAction___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__Manifest__CounterpartyAction___400_om ;
    sysml:body """ The concrete actions that discharge obligations
               (adjudicated: GAP-02 — a concrete action discharges an
               obligation and must also mutate state; the Track evidences
               both). Who acts: the manifest names a human for review
               (GATE-01) and approval (GATE-04), and those attribute
               names keep the manifest's words. For expert review and
               escalation the paper does not specify the actor, and none
               is assumed here: the actor is another system outside the
               modeled boundary, acting on the Op, with a counterparty
               assumed accountable for its behavior (provisional:
               GAP-09). """ .

