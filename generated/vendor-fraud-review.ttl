elmt:VendorFraudReview__Manifest__ErasureAwareUndecodableMetric___400
    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::Manifest::ErasureAwareUndecodableMetric::@0" ;
    sysml:elementId "VendorFraudReview__Manifest__ErasureAwareUndecodableMetric___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__Manifest__ErasureAwareUndecodableMetric ;
    sysml:owner elmt:VendorFraudReview__Manifest__ErasureAwareUndecodableMetric ;
    sysml:owningRelationship elmt:VendorFraudReview__Manifest__ErasureAwareUndecodableMetric___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__Manifest__ErasureAwareUndecodableMetric___400_om ;
    sysml:body """ Fraction of facts undecodable among EXPRESSED answers
               only: cantTell is an erasure, not an error, so a lone
               expressed voice among abstentions decodes. Incentive
               implication: abstention shifts power to whoever still
               answers. Consistent with the section 5.5 example. """ .

