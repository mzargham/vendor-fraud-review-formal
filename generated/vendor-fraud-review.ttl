elmt:VendorFraudReview__Manifest__StrictQuorumUndecodableMetric___400
    a sysml:Documentation ;
    sysml:qualifiedName "VendorFraudReview::Manifest::StrictQuorumUndecodableMetric::@0" ;
    sysml:elementId "VendorFraudReview__Manifest__StrictQuorumUndecodableMetric___400" ;
    sysx:memberIndex "0"^^xsd:integer ;
    sysml:owningNamespace elmt:VendorFraudReview__Manifest__StrictQuorumUndecodableMetric ;
    sysml:owner elmt:VendorFraudReview__Manifest__StrictQuorumUndecodableMetric ;
    sysml:owningRelationship elmt:VendorFraudReview__Manifest__StrictQuorumUndecodableMetric___400_om ;
    sysml:owningMembership elmt:VendorFraudReview__Manifest__StrictQuorumUndecodableMetric___400_om ;
    sysml:body """ Fraction of facts where no value reaches a quorum of two
               identical expressed answers; cantTell blocks quorum.
               Incentive implication: abstention is conservative — it
               escalates more runs to expert review, spending review
               capacity. Consistent with the section 5.5 example. """ .

